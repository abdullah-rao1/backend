APP_ENV=development

# --- Required ---
# Get a key at https://console.groq.com/keys
GROQ_API_KEY=gsk_your_key_here
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/smart_rag
JWT_SECRET_KEY=local-dev-secret-change-me

# --- Storage (created automatically inside this backend folder) ---
# On Railway point these at the mounted volume, e.g. /data/uploads and /data/chroma
UPLOAD_DIR=storage/uploads
CHROMA_PATH=storage/chroma

# --- Groq models (Llama 3.1 8B / 3.3 70B were retired 2026-08-16) ---
GROQ_MODEL=openai/gpt-oss-20b
GROQ_FALLBACK_MODELS=openai/gpt-oss-120b

# --- Embeddings: 384-dimension sentence-transformers model ---
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# --- CORS ---
# Local dev: "*" is fine. In production set to your Vercel URL (no trailing slash needed).
CORS_ORIGINS=*
# Optional: also allow Vercel preview deployments
# CORS_ORIGIN_REGEX=https://.*\.vercel\.app

# Optional: web-search fallback
# TAVILY_API_KEY=
